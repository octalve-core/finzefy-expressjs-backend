<!DOCTYPE html>
<html>
<head>
    <title>Email Verification</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }
        .container {
            max-width: 600px;
            margin: 40px auto;
            padding: 20px;
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            text-align: center;
        }
        .otp {
            font-size: 32px;
            font-weight: bold;
            color: #007bff;
            letter-spacing: 2px;
            margin: 20px 0;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Email Verification</h1>
        <p>Hello {{name}},</p>
        <p>Your verification code is:</p>
        <div class="otp">{{otp}}</div>
        <p>This code will expire in 10 minutes at {{otpExpiry}}.</p>
        <p>If you didn't request this verification, please ignore this email.</p>
    </div>
</body>
</html> 